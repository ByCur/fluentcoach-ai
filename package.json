{
  "name": "fluentcoach-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "engines": { "node": ">=20.20.0 <21", "pnpm": "10.28.1" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @fluentcoach/web --filter @fluentcoach/api --filter @fluentcoach/worker dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:unit": "vitest run --project unit",
    "test:boundaries": "vitest run --project boundaries",
    "test:smoke": "vitest run --project smoke"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "20.19.17",
    "eslint": "9.36.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
