datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DISABLED
  DELETING
}

enum CefrLevel {
  A1
  A2
  B1
  B2
}

model Account {
 deletionEpoch Int @default(0) @map("deletion_epoch")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oidcIssuer String @map("oidc_issuer")
  oidcSubject String @map("oidc_subject")
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  learningPlans LearningPlan[]
  planRequests LearningPlanRequest[]
  practiceEvents PracticeEvent[]
  issueDismissals IssueDismissal[]
  profile LearnerProfile?
  goals PracticeGoal[]
  consents ConsentRecord[]
  sessions PracticeSession[]
  vocabularySuggestions VocabularySuggestion[]
  vocabularyCards VocabularyCard[]
  @@unique([oidcIssuer, oidcSubject])
  @@map("accounts")
}

model VocabularySuggestion {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 phrase String @db.VarChar(160)
 normalizedPhrase String @map("normalized_phrase") @db.VarChar(160)
 meaning String? @db.VarChar(1000)
 normalizedSense String @default("") @map("normalized_sense") @db.VarChar(1000)
 sourceSessionId String? @map("source_session_id") @db.Uuid
 sourceReportId String? @map("source_report_id") @db.Uuid
 sourceRevision Int? @map("source_revision")
 evidence Json
 originVersion String @map("origin_version") @db.VarChar(40)
 state String @default("pending") @db.VarChar(12)
 sourceAvailable Boolean @default(true) @map("source_available")
 cardId String? @map("card_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 card VocabularyCard? @relation(fields:[cardId,accountId],references:[id,accountId])
 @@unique([accountId,sourceReportId,normalizedPhrase,normalizedSense])
 @@map("vocabulary_suggestions")
}
model VocabularyCard {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 phrase String @db.VarChar(160)
 normalizedPhrase String @map("normalized_phrase") @db.VarChar(160)
 meaning String? @db.VarChar(1000)
 normalizedSense String @default("") @map("normalized_sense") @db.VarChar(1000)
 sourceSuggestionId String? @map("source_suggestion_id") @db.Uuid
 sourceSessionId String? @map("source_session_id") @db.Uuid
 sourceReportId String? @map("source_report_id") @db.Uuid
 sourceRevision Int? @map("source_revision")
 sourceAvailable Boolean @default(true) @map("source_available")
 state String @default("active") @db.VarChar(12)
 schedulerVersion String @map("scheduler_version") @db.VarChar(40)
 dueAt DateTime @map("due_at") @db.Timestamptz
 intervalMinutes Int @default(0) @map("interval_minutes")
 repetitions Int @default(0)
 version Int @default(1)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 suggestions VocabularySuggestion[]
 reviews VocabularyReviewEvent[]
 @@unique([accountId,normalizedPhrase,normalizedSense])
 @@unique([id,accountId])
 @@map("vocabulary_cards")
}
model VocabularyReviewEvent {
 timezoneAtEvent String @map("timezone_at_event") @db.VarChar(64)
 localDate DateTime @map("local_date") @db.Date
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 cardId String @map("card_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 schedulerVersion String @map("scheduler_version") @db.VarChar(40)
 reviewKey String @map("review_key") @db.VarChar(100)
 previousState Json @map("previous_state")
 rating String @db.VarChar(10)
 reviewedAt DateTime @map("reviewed_at") @db.Timestamptz
 resultingState Json @map("resulting_state")
 nextDueAt DateTime @map("next_due_at") @db.Timestamptz
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 card VocabularyCard @relation(fields:[cardId,accountId],references:[id,accountId],onDelete:Cascade)
 @@unique([accountId,reviewKey])
 @@map("vocabulary_review_events")
}

model LearnerProfile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid
  interfaceLanguage String @map("interface_language") @db.VarChar(16)
  nativeLanguage String @map("native_language") @db.VarChar(16)
  timezone String @db.VarChar(64)
  cefrLevel CefrLevel @map("cefr_level")
  interests String[]
  onboardingVersion Int? @map("onboarding_version")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  sessions PracticeSession[]
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([id, accountId])
  @@map("learner_profiles")
}

model PracticeGoal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid
  minutesPerDay Int @default(10) @map("minutes_per_day")
  daysPerWeek Int @default(3) @map("days_per_week")
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@map("practice_goals")
}

model ConsentRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  purpose String @db.VarChar(80)
  policyVersion String @map("policy_version") @db.VarChar(40)
  providerDisclosureVersion String @map("provider_disclosure_version") @db.VarChar(40)
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, purpose, policyVersion, providerDisclosureVersion, acceptedAt])
  @@index([accountId, purpose, acceptedAt])
  @@map("consent_records")
}

enum SessionState {
  CREATED
  ACTIVE
  ENDED
  ABANDONED
  FAILED
}
enum ConversationMode {
  NATURAL
  TEACHING
}
model PracticeSession {
 deletionEpoch Int @default(0) @map("deletion_epoch")
 practiceEvents PracticeEvent[]
 planActivities LearningPlanActivity[]
 turnLeaseToken String? @map("turn_lease_token") @db.Uuid
 turnLeaseUntil DateTime? @map("turn_lease_until") @db.Timestamptz
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  scenarioSlug String @map("scenario_slug") @db.VarChar(40)
  scenarioVersion Int @map("scenario_version")
  level CefrLevel
  mode ConversationMode
  promptVersion String @map("prompt_version") @db.VarChar(40)
  state SessionState @default(CREATED)
  transcriptRevision Int @default(0) @map("transcript_revision")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  endedAt DateTime? @map("ended_at") @db.Timestamptz
  turns ConversationTurn[]
  events SessionEvent[]
  analyses AnalysisRun[]
  revisions TranscriptRevision[]
  revisionReceipts TranscriptRevisionReceipt[]
  outbox OutboxEvent[]
  account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
  profile LearnerProfile @relation(fields:[profileId,accountId],references:[id,accountId],onDelete:Cascade)
  @@index([accountId, createdAt])
  @@unique([id, accountId])
  @@map("practice_sessions")
}
model ConversationTurn {
 practiceEvents PracticeEvent[]
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 sequence Int
 sourceEventKey String @map("source_event_key") @db.VarChar(100)
 speaker String @db.VarChar(16)
 text String
 language String @db.VarChar(8)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 session PracticeSession @relation(fields:[sessionId,accountId],references:[id,accountId],onDelete:Cascade)
 @@unique([sessionId,sequence])
 @@unique([id,accountId,sessionId],map:"turns_id_account_session_key")
 @@unique([sessionId,sourceEventKey])
 @@map("conversation_turns")
}
model SessionEvent {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 sequence Int
 kind String @db.VarChar(50)
 payload Json
 occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz
 session PracticeSession @relation(fields:[sessionId,accountId],references:[id,accountId],onDelete:Cascade)
 @@unique([sessionId,sequence])
 @@index([accountId,sessionId,sequence])
 @@map("session_events")
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}
model AnalysisRun {
 deletionEpoch Int @default(0) @map("deletion_epoch")
 leaseToken String? @map("lease_token") @db.Uuid
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 transcriptRevision Int @map("transcript_revision")
 analyzerVersion String @map("analyzer_version") @db.VarChar(40)
 status AnalysisStatus @default(PENDING)
 attempts Int @default(0)
 leaseUntil DateTime? @map("lease_until") @db.Timestamptz
 errorCode String? @map("error_code") @db.VarChar(80)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 session PracticeSession @relation(fields:[sessionId,accountId],references:[id,accountId],onDelete:Cascade)
 providers ProviderRun[]
 @@unique([sessionId,transcriptRevision,analyzerVersion])
 @@unique([id,accountId])
 @@index([accountId,status])
 @@map("analysis_runs")
}
model OutboxEvent {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 aggregateId String @map("aggregate_id") @db.Uuid
 eventType String @map("event_type") @db.VarChar(80)
 envelopeVersion Int @map("envelope_version")
 payload Json
 dedupeKey String @unique @map("dedupe_key") @db.VarChar(160)
 attempts Int @default(0)
 publishedAt DateTime? @map("published_at") @db.Timestamptz
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 session PracticeSession @relation(fields:[aggregateId,accountId],references:[id,accountId],onDelete:Cascade)
 @@index([publishedAt,createdAt])
 @@map("outbox_events")
}
model ProviderRun {
 sessionId String? @map("session_id") @db.Uuid
 requestId String? @map("request_id") @db.VarChar(200)
 inputTokens Int? @map("input_tokens")
 outputTokens Int? @map("output_tokens")
 finishReason String? @map("finish_reason") @db.VarChar(40)
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 analysisRunId String? @map("analysis_run_id") @db.Uuid
 operation String @db.VarChar(40)
 adapter String @db.VarChar(40)
 model String @db.VarChar(80)
 promptVersion String @map("prompt_version") @db.VarChar(40)
 schemaVersion String @map("schema_version") @db.VarChar(40)
 outcome String @db.VarChar(30)
 latencyMs Int @map("latency_ms")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 analysis AnalysisRun? @relation(fields:[analysisRunId,accountId],references:[id,accountId],onDelete:Cascade)
 @@unique([analysisRunId])
 @@index([accountId,analysisRunId])
 @@map("provider_runs")
}

model TranscriptRevision {
 observations IssueObservation[]
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 revision Int
 sourceKey String @map("source_key") @db.VarChar(100)
 contentHash String @map("content_hash") @db.VarChar(64)
 turns Json
 partial Boolean
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 session PracticeSession @relation(fields:[sessionId,accountId],references:[id,accountId],onDelete:Cascade)
 receipts TranscriptRevisionReceipt[]
 @@unique([sessionId,revision])
 @@unique([sessionId,sourceKey])
 @@unique([sessionId,contentHash])
 @@map("transcript_revisions")
}

model TranscriptRevisionReceipt {
 sessionId String @map("session_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 sourceKey String @map("source_key") @db.VarChar(100)
 revision Int
 session PracticeSession @relation(fields:[sessionId,accountId],references:[id,accountId],onDelete:Cascade)
 transcript TranscriptRevision @relation(fields:[sessionId,revision],references:[sessionId,revision],onDelete:Cascade)
 @@id([sessionId,sourceKey])
 @@map("transcript_revision_receipts")
}

model SessionReport {
 observations IssueObservation[]
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 analysisRunId String @unique @map("analysis_run_id") @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 transcriptRevision Int @map("transcript_revision")
 schemaVersion String @map("schema_version") @db.VarChar(40)
 content Json
 partial Boolean @default(false)
 generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz
 @@unique([sessionId,accountId])
 @@unique([id,accountId],map:"session_reports_id_account_key")
 @@unique([id,accountId,sessionId,transcriptRevision,analysisRunId],map:"report_observation_source_key")
 @@map("session_reports")
}
model AiDailyBudget {
 model String @db.VarChar(80)
 day DateTime @db.Date
 requests Int
 tokens Int
 blocked Boolean @default(false)
 @@id([model,day])
 @@map("ai_daily_budgets")
}
model AiBudgetReservation {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 model String @db.VarChar(80)
 day DateTime @db.Date
 reservedTokens Int @map("reserved_tokens")
 inputTokens Int? @map("input_tokens")
 outputTokens Int? @map("output_tokens")
 @@map("ai_budget_reservations")
}

// M07: reports are authoritative; the SQL recurring_issue_aggregates view is derived.
model IssueObservation {
 accountId String @map("account_id") @db.Uuid
 taxonomyVersion String @map("taxonomy_version") @db.VarChar(40)
 issueKey String @map("issue_key") @db.VarChar(40)
 label String @db.VarChar(80)
 category String @db.VarChar(20)
 sessionId String @map("session_id") @db.Uuid
 reportId String @map("report_id") @db.Uuid
 analysisRunId String @map("analysis_run_id") @db.Uuid
 transcriptRevision Int @map("transcript_revision")
 turnSequence Int @map("turn_sequence")
 evidenceStart Int @map("evidence_start")
 evidenceEnd Int @map("evidence_end")
 quote String
 uncertainty String @db.VarChar(10)
 occurredAt DateTime @map("occurred_at") @db.Timestamptz
 report SessionReport @relation(fields:[reportId,accountId,sessionId,transcriptRevision,analysisRunId],references:[id,accountId,sessionId,transcriptRevision,analysisRunId],onDelete:Cascade)
 transcript TranscriptRevision @relation(fields:[sessionId,transcriptRevision],references:[sessionId,revision],onDelete:Cascade)
 @@id([accountId,taxonomyVersion,issueKey,sessionId,turnSequence])
 @@index([accountId,occurredAt],map:"issue_observations_account_time_idx")
 @@map("issue_observations")
}
model IssueDismissal {
 accountId String @map("account_id") @db.Uuid
 taxonomyVersion String @map("taxonomy_version") @db.VarChar(40)
 issueKey String @map("issue_key") @db.VarChar(40)
 dismissedAt DateTime @default(now()) @map("dismissed_at") @db.Timestamptz
 restoredAt DateTime? @map("restored_at") @db.Timestamptz
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 @@id([accountId,taxonomyVersion,issueKey])
 @@map("issue_dismissals")
}

// Partial current-plan indexes, checks, date/immutability triggers are owned by M09 SQL.
model LearningPlan {
 roadmapSignature String? @map("roadmap_signature")
 adaptedAt DateTime? @map("adapted_at") @db.Timestamptz
 deletionEpoch Int @default(0) @map("deletion_epoch")
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 schemaVersion String @map("schema_version") @db.VarChar(40)
 generatorVersion String @map("generator_version") @db.VarChar(40)
 catalogVersion String @map("catalog_version") @db.VarChar(40)
 version Int @default(1)
 state String @default("proposal") @db.VarChar(12)
 sourceSnapshot Json @map("source_snapshot")
 rationale String
 insufficientData Boolean @map("insufficient_data")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
 acceptedFromVersion Int? @map("accepted_from_version")
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 activities LearningPlanActivity[]
 requests LearningPlanRequest[]
 @@unique([id,accountId])
 @@map("learning_plans")
}
model LearningPlanActivity {
 position Int @default(0)
 startedFromVersion Int? @map("started_from_version")
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 planId String @map("plan_id") @db.Uuid
 catalogVersion String @map("catalog_version") @db.VarChar(40)
 candidateId String @map("candidate_id") @db.VarChar(100)
 activityType String @map("activity_type") @db.VarChar(30)
 definition Json
 state String @default("pending") @db.VarChar(12)
 startedAt DateTime? @map("started_at") @db.Timestamptz
 sessionId String? @unique @map("session_id") @db.Uuid
 skippedFromVersion Int? @map("skipped_from_version")
 plan LearningPlan @relation(fields:[planId,accountId],references:[id,accountId],onDelete:Cascade)
 // SQL clears only session_id, preserving non-null owner on source deletion.
 session PracticeSession? @relation(fields:[sessionId,accountId],references:[id,accountId],onDelete:NoAction)
 @@unique([planId,candidateId])
 @@unique([id,accountId])
 @@map("learning_plan_activities")
}
model LearningPlanRequest {
 accountId String @map("account_id") @db.Uuid
 requestKey String @map("request_key") @db.VarChar(100)
 planId String @map("plan_id") @db.Uuid
 signature String
 plan LearningPlan @relation(fields:[planId,accountId],references:[id,accountId],onDelete:Cascade)
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 @@id([accountId,requestKey])
 @@map("learning_plan_requests")
}
model PracticeEvent {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 turnId String? @map("turn_id") @db.Uuid
 sourceKey String @map("source_key") @db.VarChar(110)
 kind String @db.VarChar(20)
 durationMs Int @map("duration_ms")
 occurredAt DateTime @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz
 timezoneAtEvent String @map("timezone_at_event") @db.VarChar(64)
 localDate DateTime @map("local_date") @db.Date
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 session PracticeSession @relation(fields:[sessionId,accountId],references:[id,accountId],onDelete:Cascade)
 turn ConversationTurn? @relation(fields:[turnId,accountId,sessionId],references:[id,accountId,sessionId],onDelete:Cascade)
 @@unique([accountId,sessionId,sourceKey])
 @@index([accountId,localDate],map:"practice_events_account_date_idx")
 @@map("practice_events")
}

model PrivacyJob {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 kind String @db.VarChar(12)
 version String @default("privacy-job-v1") @db.VarChar(40)
 state String @default("pending") @db.VarChar(12)
 requestKey String @map("request_key") @db.Uuid
 deletionEpoch Int @map("deletion_epoch")
 attempts Int @default(0)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 startedAt DateTime? @map("started_at") @db.Timestamptz
 completedAt DateTime? @map("completed_at") @db.Timestamptz
 errorCode String? @map("error_code") @db.VarChar(40)
 @@unique([accountId,kind,requestKey])
 @@unique([id,accountId])
 @@map("privacy_jobs")
}
model PrivacyExportArtifact {
 jobId String @id @map("job_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 content Json
 sizeBytes Int @map("size_bytes")
 expiresAt DateTime @map("expires_at") @db.Timestamptz
 @@map("privacy_export_artifacts")
}
model DeletionTombstone {
 accountId String @id @map("account_id") @db.Uuid
 deletionEpoch Int @map("deletion_epoch")
 requestedAt DateTime @map("requested_at") @db.Timestamptz
 completedAt DateTime? @map("completed_at") @db.Timestamptz
 protocolVersion String @map("protocol_version") @db.VarChar(40)
 schemaVersion String @map("schema_version") @db.VarChar(40)
 @@map("deletion_tombstones")
}

model ReleaseControl {
 singleton Boolean @id @default(true)
 draining Boolean @default(false)
 changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz
 @@map("release_control")
}

model QstashPublicationBudget {
 day DateTime @id @db.Date
 publications Int
 blocked Boolean @default(false)
 @@map("qstash_publication_budgets")
}
