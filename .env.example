# Local-only defaults. Copy to .env; never commit the resulting file.
APP_ENVIRONMENT=local
NODE_ENV=development
DEPLOY_WORKER=false
API_PORT=3000
WEB_PORT=4173
DATABASE_URL=postgresql://fluentcoach:local-development-only@localhost:5432/fluentcoach
REDIS_URL=redis://localhost:6379
PUBLIC_API_BASE_URL=/api/v1

# The zero-cost pilot rejects every billable mode/provider.
BILLING_MODE=free_only
PUBLIC_ORIGIN=http://localhost:8080
# OIDC production values are server-only and intentionally blank; use exact Auth0 Free values in the deployment secret/config store.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_CALLBACK_URL=
OIDC_LOGOUT_URL=

# Text AI is local-first and never falls back implicitly. Ollama needs no key.
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Local push-to-talk transcription. Start whisper-server with --convert so
# browser WebM/Opus can be converted by host ffmpeg. No API key is used.
SPEECH_PROVIDER=whisper-cpp
WHISPER_BASE_URL=http://127.0.0.1:8080
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT_MS=45000
# Optional Gemini remains synthetic-only until later privacy/release gates. Select
# AI_PROVIDER=gemini-free only after completing the approval fields below.
# Fill ONLY after owner review of actual Gemini Free eligibility, quotas and terms.
AI_FREE_TIER_APPROVED=false
AI_SYNTHETIC_ONLY=true
AI_FREE_TIER_REVIEW_ID=
GEMINI_API_KEY=
# Candidate, not verified current/free by this implementation.
GEMINI_MODEL=gemini-3.8-flash
AI_QUOTA_VERIFIED_UNTIL=
AI_DAILY_REQUESTS=
AI_DAILY_TOKENS=
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=

# Release identity comes from the immutable build manifest; never use invented digests.
# RELEASE_COMMIT_SHA=
# RELEASE_IMAGE_DIGEST=
# RELEASE_MIGRATION_VERSION=202610060002_m11_release_control
# PUBLIC_API_ORIGIN= (exact API HTTPS origin for QStash signature binding)
